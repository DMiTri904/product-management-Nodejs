extends ../../layouts/default.pug

block main
  if(data.title)
    h1(class="mb-4") #{data.title}
  if(parent.title)
    div(class="mb-4") Danh mục cha: <b> #{parent.title}</b>
  if(data.description)
    div(class="mb-4") Mô tả: <b> !{data.description}</b>
  if(data.thumbnail)
    div(class="mb-4")
      img(
        src=data.thumbnail 
        style = "width: 100px"
      )  
  if(data.status)
    div(class="mb-4")
      span Trạng thái: 
      if(data.status === "active")
        span(class="badge rounded-pill text-bg-primary") Hoạt động
      else
        span(class="badge badge-pill text-bg-danger") Dừng hoạt động
  if(data.position)
    div(class="mb-4") Vị trí: <b> #{data.position}</b>
  if(data.description)
    div(class="mb-4") !{data.description} 

  a(
    href=`${prefixAdmin}/product-category/edit/${data.id}`
    class="btn btn-warning") Chỉnh sửa 

  script(src="/admin/js/product_category.js") 